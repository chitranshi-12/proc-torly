# ==========================================
# exam.co Backend Environment Variables (Render / Local)
# ==========================================
PORT=3000
NODE_ENV=development

# MongoDB Atlas Database URI (Default database: exam_co)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/exam_co?retryWrites=true&w=majority
DB_NAME=exam_co

# Allowed Frontend Origins (comma-separated, without trailing slashes)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-examco-app.vercel.app

# Firebase Authentication (Server-Side Admin SDK)
FIREBASE_PROJECT_ID=pure-night-k3kqt
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or paste complete Firebase Service Account JSON string in FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_SERVICE_ACCOUNT_JSON=

# Student Session Secret (Required in production - must be strong, unpredictable random string)
JWT_SECRET=<strong-cryptographic-random-secret>

# ==========================================
# exam.co Frontend Environment Variables (Vercel Build-time)
# ==========================================
# Render API origin without trailing slash (e.g. https://examco-api.onrender.com)
VITE_API_BASE_URL=

# Firebase Client Web Configuration (Auto-loaded from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=<your-firebase-web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<your-firebase-project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pure-night-k3kqt
VITE_FIREBASE_APP_ID=<your-firebase-web-app-id>
