# App URL (change to your production URL when deploying)
APP_URL="http://localhost:3000"

# Server Port
PORT=3000

# JWT Authentication Secret Key (change this in production!)
JWT_SECRET="omni_proctor_super_secret_jwt_encryption_key_change_in_production"

# ─────────────────────────────────────────────────────────────
# Google sign-in uses Firebase Authentication and firebase-applet-config.json.
# Enable the Google provider in Firebase Console > Authentication > Sign-in method.

# Optional: Gemini AI API Key
GEMINI_API_KEY="your-gemini-api-key"

# Default Admin Credentials (seeded automatically on first run)
# Email: admin@proctor.edu
# Password: Admin@12345
